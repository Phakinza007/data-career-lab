---
import LessonNav from '../../../components/LessonNav';
import Base from '../../../layouts/Base.astro';
import { getTrack } from '../../../lib/content/catalog';
import type { ModuleRef } from '../../../lib/content/refs';
import { TRACK_IDS, trackInfo, type TrackId } from '../../../lib/tracks';
import { url } from '../../../lib/url';

export async function getStaticPaths() {
  const all = await Promise.all(TRACK_IDS.map(async (track) => (await getTrack(track)).map((m) => ({ params: { track, module: m.slug }, props: { mod: m } }))));
  return all.flat();
}
const { mod } = Astro.props as { mod: ModuleRef };
const track = Astro.params.track as TrackId;
const info = trackInfo(track);
---
<Base title={mod.title}>
  <p class="crumb"><a href={url(`/${track}/`)}>{info.title}</a> › Module {mod.order}</p>
  <h1>{mod.title}</h1>
  <p class="lead">{mod.description}</p>
  {mod.lessons.length === 0 ? (
    <p class="card">เนื้อหาส่วนนี้กำลังเขียน</p>
  ) : (
    <LessonNav client:only="react" lessons={mod.lessons} currentId={null} />
  )}
  {mod.practiceUrl && <a class="button primary" href={mod.practiceUrl}>ชุดฝึกท้าย module</a>}
</Base>
