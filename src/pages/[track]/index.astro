---
import ModuleProgress from '../../components/ModuleProgress';
import Base from '../../layouts/Base.astro';
import { getTrack } from '../../lib/content/catalog';
import { TRACK_IDS, trackInfo, type TrackId } from '../../lib/tracks';

export function getStaticPaths() {
  return TRACK_IDS.map((track) => ({ params: { track } }));
}
const track = Astro.params.track as TrackId;
const info = trackInfo(track);
const modules = await getTrack(track);
---
<Base title={info.title}>
  <h1>สาย {info.title}</h1>
  <p class="lead">{info.lead}</p>
  <ol class="module-list">
    {modules.map((m) => (
      <li class="card module-card">
        <div>
          <p class="step">Module {m.order}</p>
          <h2><a href={m.url}>{m.title}</a></h2>
          <p class="muted">{m.description}</p>
        </div>
        {m.lessons.length > 0 ? <ModuleProgress client:only="react" lessons={m.lessons} /> : <span class="badge">กำลังเขียน</span>}
      </li>
    ))}
  </ol>
</Base>
