---
import Base from '../layouts/Base.astro';
import Flashcards from '../components/Flashcards';
import { getModules } from '../lib/content/catalog';
import { TRACK_IDS } from '../lib/tracks';
import { getFlashcardPool } from '../lib/content/flashcards';

const [cards, modules] = await Promise.all([getFlashcardPool(TRACK_IDS), getModules(TRACK_IDS)]);
---
<Base title="ทบทวน">
  <h1>ทบทวนคำศัพท์</h1>
  <p class="lead">Flashcard แบบ Leitner — ตอบถูกเลื่อนขึ้นกล่อง ตอบผิดกลับไปกล่อง 1 เพื่อทวนถี่ขึ้น</p>
  <Flashcards client:only="react" cards={cards} modules={modules} />
</Base>
